---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ImageText from '../components/ImageText.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { getHomepage } from '../lib/sanity';

const home = await getHomepage();
---

<Layout title='Home'>
	<Hero
		heading={home?.heroHeading ?? 'Welcome'}
		subheading={home?.heroSubheading}
		image={home?.heroImage}
	/>

	{
		home?.aboutHeading && (
			<ImageText
				heading={home.aboutHeading}
				text={home.aboutText}
				image={home.aboutImage}
				reverse={true}
			/>
		)
	}

	{
		home?.selectedWork?.length > 0 && (
			<section class='selected-work'>
				<div class='container'>
					<h2>Selected Work</h2>
					<div class='grid'>
						{home.selectedWork.map((project: any) => (
							<ProjectCard {...project} />
						))}
					</div>
					<a class='view-all' href='/projects'>
						View all projects →
					</a>
				</div>
			</section>
		)
	}

	{
		home?.featuredServices?.length > 0 && (
			<section class='services'>
				<div class='container'>
					<h2>Services</h2>
					<div class='grid'>
						{home.featuredServices.map((service: any) => (
							<ServiceCard {...service} />
						))}
					</div>
					<a class='view-all' href='/services'>
						View all services →
					</a>
				</div>
			</section>
		)
	}

	{
		home?.featuredTestimonials?.length > 0 && (
			<section class='testimonials'>
				<div class='container'>
					<h2>What clients say</h2>
					<div class='grid'>
						{home.featuredTestimonials.map((testimonial: any) => (
							<TestimonialCard {...testimonial} />
						))}
					</div>
				</div>
			</section>
		)
	}
</Layout>

<style>
	section {
		padding-block: 3rem;
	}
	.grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}
	.view-all {
		display: inline-block;
		margin-top: 1.5rem;
		font-weight: 600;
	}
</style>
