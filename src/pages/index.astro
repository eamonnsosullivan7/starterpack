---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ImageText from '../components/ImageText.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import { getHomepage } from '../lib/sanity';

const home = await getHomepage();
const selectedWork = home?.selectedWork ?? [];
const featuredTestimonials = home?.featuredTestimonials ?? [];
const featuredServices = home?.featuredServices ?? [];
const featuredFaqs = home?.featuredFaqs ?? [];
---

<Layout title='Home'>
	<div class='container'>
		<Hero
			heading={home?.heroHeading ?? 'Welcome'}
			subheading={home?.heroSubheading}
			image={home?.heroImage}
		/>
	</div>

	{
		home?.aboutHeading && (
			<div class='container'>
				<ImageText
					heading={home.aboutHeading}
					text={home.aboutText}
					image={home.aboutImage}
					reverse={true}
				/>
			</div>
		)
	}

	{
		selectedWork.length > 0 && (
			<SelectedWork heading='Selected Work' items={selectedWork} />
		)
	}

	{
		featuredTestimonials.length > 0 && (
			<div class='container'>
				<Testimonials
					heading='From our community'
					subheading='Heres what our clients have to say'
					items={featuredTestimonials}
				/>
			</div>
		)
	}

	{
		featuredServices.length > 0 && (
			<Services heading='Services' items={featuredServices} />
		)
	}

	{
		featuredFaqs.length > 0 && (
			<div class='container'>
				<Faq
					heading={home?.faqHeading ?? 'FAQ'}
					items={featuredFaqs}
				/>
			</div>
		)
	}
	<!-- 
	<section class='cta'>
		<div class='container'>
			<div class='form-wrapper'>
				<h2>Let's work together...</h2>

				<a class='btn-primary' href='/contact'>Send us a message</a>
			</div>
		</div>
	</section> -->
</Layout>

<style>
	section {
		padding-block: var(--section-block);
	}
	.form-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	.btn-primary {
		padding: 1rem 2rem;
		background-color: var(--color-secondary);
		color: var(--color-primary);
		text-decoration: none;
		border-radius: 0.5rem;
	}
</style>
