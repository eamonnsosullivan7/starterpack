---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ImageText from '../components/ImageText.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { getHomepage } from '../lib/sanity';

const home = await getHomepage();
---

<Layout title='Home'>
	<div class='container'>
		<Hero
			heading={home?.heroHeading ?? 'Welcome'}
			subheading={home?.heroSubheading}
			image={home?.heroImage}
		/>
	</div>

	{
		home?.aboutHeading && (
			<div class='container'>
				<ImageText
					heading={home.aboutHeading}
					text={home.aboutText}
					image={home.aboutImage}
					reverse={true}
				/>
			</div>
		)
	}

	{
		home?.selectedWork?.length > 0 && (
			<section class='selected-work'>
				<div class='container'>
					<h2>Selected Work</h2>
					<div class='grid'>
						{home.selectedWork.map((project: any) => (
							<ProjectCard {...project} />
						))}
					</div>
					<div class='view-all-wrapper'>
						<a class='view-all' href='/projects'>
							View all projects →
						</a>
					</div>
				</div>
			</section>
		)
	}

	{
		home?.featuredServices?.length > 0 && (
			<section class='services'>
				<div class='container'>
					<h2>Services</h2>
					<div class='grid'>
						{home.featuredServices.map((service: any) => (
							<ServiceCard {...service} />
						))}
					</div>
					<div class='view-all-wrapper'>
						<a class='view-all' href='/services'>
							View all services →
						</a>
					</div>
				</div>
			</section>
		)
	}

	{
		home?.featuredTestimonials?.length > 0 && (
			<section class='testimonials'>
				<div class='container'>
					<h2>What clients say</h2>
					<div class='grid'>
						{home.featuredTestimonials.map((testimonial: any) => (
							<TestimonialCard {...testimonial} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class='cta'>
		<div class='container'>
			<div class='form-wrapper'>
				<h2>Let's work together...</h2>

				<a class='btn-primary' href='/contact'>Send us a message</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	section {
		padding-block: 3rem;
	}
	.grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}

	h2 {
		font-size: 2rem;
		margin: 3rem 0 1.5rem 0;
	}

	.view-all-wrapper {
		display: flex;
		justify-content: flex-end;
	}
	.view-all {
		display: inline-block;
		margin-top: 1.5rem;
		font-weight: 600;
		color: var(--color-text-seconday);
	}

	.services {
		background-color: var(--color-secondary);
		color: var(--color-primary);
	}
	.services h2 {
		color: var(--color-primary);
	}
	.form-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
	}
	.btn-primary {
		padding: 1rem 2rem;
		background-color: var(--color-secondary);
		color: var(--color-primary);
		text-decoration: none;
		border-radius: 0.5rem;
	}
</style>
