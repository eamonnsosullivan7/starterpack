---
import Layout from '../../layouts/Layout.astro';
import { getServiceBySlug, getAllServices } from '../../lib/sanity';

export async function getStaticPaths() {
  const services = await getAllServices();
  return services.map((service) => ({
    params: { slug: service.slug!.current },
  }));
}

const { slug } = Astro.params;
const service = await getServiceBySlug(slug!);

const serviceSchema = service && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.description ?? service.summary,
};
---

<Layout title={service?.title ?? slug}>
  {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  <h1>{service?.title}</h1>
  {service?.price && <p class="price">{service.price}</p>}
  <div class="description">
    {service?.description}
  </div>
</Layout>

<style>
  .price {
    font-weight: 600;
  }
  .description {
    max-width: 42rem;
  }
</style>
