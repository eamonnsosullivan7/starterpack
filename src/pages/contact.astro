---
import Layout from '../layouts/Layout.astro';
import { getSimplePageBySlug } from '../lib/sanity';
import { blocksToParagraphs } from '../lib/portableText';

const page = await getSimplePageBySlug('contact');
---

<Layout title={page?.title ?? 'Contact'} description={page?.seoDescription}>
	<div class='container'>
		<h1>{page?.title ?? 'Contact us'}</h1>
		{blocksToParagraphs(page?.body).map((para) => <p>{para}</p>)}

		<!-- TODO: wire up submission — Astro API route, or a third-party form
       backend, once this is deployed for a specific client. -->
		<form
			class='contact-form'
			onsubmit='return false'
			data-todo='wire up submission'
		>
			<label for='name'>Name</label>
			<input id='name' name='name' type='text' autocomplete='name' required />

			<label for='email'>Email</label>
			<input
				id='email'
				name='email'
				type='email'
				autocomplete='email'
				required
			/>

			<label for='message'>Message</label>
			<textarea id='message' name='message' rows='6' required></textarea>

			<button type='submit'>Send message</button>
		</form>
	</div>
</Layout>

<style>
	.contact-form {
		display: grid;
		gap: 0.5rem;
		max-width: 32rem;
		margin-top: 2rem;
	}
	.contact-form label {
		font-weight: 600;
		margin-top: 0.5rem;
	}
	.contact-form input,
	.contact-form textarea {
		font: inherit;
		padding: 0.6rem 0.75rem;
		border: 1px solid #ccc;
		border-radius: 0.375rem;
	}
	.contact-form button {
		justify-self: start;
		margin-top: 0.5rem;
		padding: 0.7rem 1.5rem;
		border: none;
		border-radius: 0.375rem;
		background: #111;
		color: #fff;
		font-weight: 600;
		cursor: pointer;
	}
</style>
