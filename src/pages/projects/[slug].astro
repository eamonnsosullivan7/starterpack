---
import Layout from '../../layouts/Layout.astro';
import { getProjectBySlug, getAllProjects } from '../../lib/sanity';
import { imageDimensions, imageUrl } from '../../lib/image';
import { blocksToParagraphs } from '../../lib/portableText';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
	const projects = await getAllProjects();
	return projects.map((project) => ({
		params: { slug: project.slug!.current },
	}));
}

const { slug } = Astro.params;
const project = await getProjectBySlug(slug!);
const coverSrc = imageUrl(project?.coverImage, { width: 1600 });
const coverDimensions = imageDimensions(project?.coverImage, 1600);

const projectGallery = (project?.gallery ?? []).map((image) => ({
	src: imageUrl(image, { width: 1000 }),
	dimensions: imageDimensions(image, 1000),
}));

const projectSchema = project && {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description: project.shortDescription,
	image: coverSrc ?? undefined,
};
---

<Layout title={project?.title ?? slug}>
	{projectSchema && <script type='application/ld+json' set:html={JSON.stringify(projectSchema)} />}
	<div class='container'>
		<a href='/projects' class='back-button'>
			<Icon class='icon' name={`iconoir:arrow-left`} /> Back to Projects
		</a>
		<div class='project-layout'>
			<div class='info'>
				<h1 class='title'>{project?.title}</h1>
				<div class='description'>
					{
						blocksToParagraphs(project?.description).map((para) => (
							<p>{para}</p>
						))
					}
				</div>
			</div>

			{
				coverSrc && coverDimensions && (
					<img
						class='cover'
						src={coverSrc}
						width={coverDimensions.width}
						height={coverDimensions.height}
						alt={project?.title ?? ''}
						fetchpriority='high'
					/>
				)
			}

			{
				projectGallery.length > 0 && (
					<div class='gallery'>
						{projectGallery.map(
							(image, index) =>
								image.src &&
								image.dimensions && (
									<img
										src={image.src}
										width={image.dimensions.width}
										height={image.dimensions.height}
										alt={`${project?.title ?? ''} — photo ${index + 1}`}
										loading='lazy'
									/>
								),
						)}
					</div>
				)
			}
		</div>
	</div>
</Layout>

<style>
	.project-layout {
		display: grid;
		gap: 1.5rem;
		grid-template-areas:
			'title'
			'cover'
			'description'
			'gallery';
	}

	.info {
		display: contents;
	}
	.title {
		grid-area: title;
	}
	.description {
		grid-area: description;
	}

	.cover {
		grid-area: cover;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}

	.gallery {
		grid-area: gallery;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}
	.gallery img {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}

	.back-button {
		display: flex;
		align-items: center;
		gap: 5px;
		margin-bottom: 2rem;
	}

	@media (min-width: 992px) {
		.project-layout {
			grid-template-columns: 1.5fr 1fr;
			align-items: start;
			gap: 2rem 3rem;
			grid-template-areas:
				'cover   info'
				'gallery info';
		}

		.info {
			display: flex;
			flex-direction: column;
			justify-content: center;
			grid-area: info;
			position: sticky;
			top: 2rem;
			background-color: var(--color-secondary);
			color: var(--color-primary);
			padding: 2rem;
			border-radius: 0.5rem;
			height: calc(100vh - 8rem);
			margin-right: 3rem;
		}
		.title {
			color: inherit;
		}
	}
</style>
