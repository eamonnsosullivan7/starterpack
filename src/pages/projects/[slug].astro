---
import Layout from '../../layouts/Layout.astro';
import { getProjectBySlug, getAllProjects } from '../../lib/sanity';
import { imageUrl } from '../../lib/image';
import { blocksToParagraphs } from '../../lib/portableText';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
	const projects = await getAllProjects();
	return projects.map((project) => ({
		params: { slug: project.slug!.current },
	}));
}

const { slug } = Astro.params;
const project = await getProjectBySlug(slug!);
const coverSrc = imageUrl(project?.coverImage, { width: 1600 });

const projectGallery = project?.gallery ?? [];
---

<Layout title={project?.title ?? slug}>
	<div class='container'>
		<a href='/projects' class='back-button'>
			<Icon class='icon' name={`iconoir:arrow-left`} /> Back to Projects
		</a>
		<div class='project-layout'>
			<div class='info'>
				<h1 class='title'>{project?.title}</h1>
				<div class='description'>
					{
						blocksToParagraphs(project?.description).map((para) => (
							<p>{para}</p>
						))
					}
				</div>
			</div>

			{coverSrc && <img class='cover' src={coverSrc} alt='' />}

			{
				projectGallery.length > 0 && (
					<div class='gallery'>
						{projectGallery.map((image) => (
							<img src={imageUrl(image, { width: 1000 })} alt='' />
						))}
					</div>
				)
			}
		</div>
	</div>
</Layout>

<style>
	.project-layout {
		display: grid;
		gap: 1.5rem;
		grid-template-areas:
			'title'
			'cover'
			'description'
			'gallery';
	}

	/* Mobile: .info "disappears" from the box tree — title and description
	   become direct grid items of .project-layout, so they can be placed
	   independently (with the cover image in between them) via the areas
	   above, instead of staying grouped together as one block. */
	.info {
		display: contents;
	}
	.title {
		grid-area: title;
	}
	.description {
		grid-area: description;
	}

	.cover {
		grid-area: cover;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}

	.gallery {
		grid-area: gallery;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}
	.gallery img {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}

	.back-button {
		display: flex;
		align-items: center;
		gap: 5px;
		margin-bottom: 2rem;
	}

	@media (min-width: 992px) {
		.project-layout {
			grid-template-columns: 1.5fr 1fr;
			align-items: start;
			gap: 2rem 3rem;
			grid-template-areas:
				'cover   info'
				'gallery info';
		}

		.info {
			display: flex;
			flex-direction: column;
			justify-content: center;
			grid-area: info;
			position: sticky;
			top: 2rem;
			background-color: var(--color-secondary);
			color: var(--color-primary);
			padding: 2rem;
			border-radius: 0.5rem;
			height: calc(100vh - 8rem);
			margin-right: 3rem;
		}
		.title {
			color: inherit;
		}
	}
</style>
