---
import '../lib/global.css';
import { findSocialLink, getSiteSettings, getThemeColors } from '../lib/sanity';
import { imageUrl } from '../lib/image';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import OrganizationSchema from '../components/OrganizationSchema.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title ?? 'Site';
const logoUrl = imageUrl(settings?.logo, { height: 64 });
const faviconUrl =
	imageUrl(settings?.favicon, { width: 64, height: 64 }) ?? '/favicon.svg';
const instagramUrl = findSocialLink(settings?.socialLinks, 'instagram');
const colorVars = getThemeColors(settings);
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const socialUrls = (settings?.socialLinks ?? [])
	.map((link) => link.url)
	.filter((url): url is string => !!url);
---

<!doctype html>
<html lang='en'>
	<Head
		title={title}
		siteTitle={siteTitle}
		description={description ?? settings?.description ?? ''}
		favicon={faviconUrl}
	/>
	<body>
		<OrganizationSchema
			name={settings?.companyName ?? siteTitle}
			url={siteUrl}
			logo={logoUrl ?? undefined}
			telephone={settings?.phone}
			address={settings?.companyAddress}
			sameAs={socialUrls}
		/>
		<Nav logo={logoUrl} siteTitle={siteTitle} navItems={settings?.navItems} />

		<main>
			<slot />
		</main>

		<Footer
			logoUrl={logoUrl ?? ''}
			companyName={settings?.companyName ?? siteTitle}
			companyAddress={settings?.companyAddress}
			phone={settings?.phone}
			instagramUrl={instagramUrl}
		/>

		<style define:vars={colorVars}>
			:root {
				--max-width: 72rem;
				--space-sml: 1rem;
				--space-md: 1.5rem;
				--space-lg: 2rem;
				--space-xl: 3rem;
				--color-primary: var(--colorPrimary);
				--color-secondary: var(--colorSecondary);
				--color-accent: var(--colorAccent);
				--color-text-primary: #1a1a1a;
				--color-text-secondary: #262626;
				--color-text-tertiary: #444545;
			}
			body {
				margin: 0;
				font-family: Arial, Helvetica, sans-serif;
				line-height: 1.5;
				background-color: var(--color-primary);
				color: var(--color-text-secondary);
			}

			main {
				margin-inline: auto;
				padding-bottom: 80px;
			}
		</style>
	</body>
</html>
