---
import { urlFor } from '../lib/sanity';
import { blocksToParagraphs } from '../lib/portableText';

interface Props {
	heading?: string;
	text?: any;
	image?: any;
	reverse?: boolean;
}
const { heading, text, image, reverse = false } = Astro.props;
const src = image ? urlFor(image).width(1200).auto('format').url() : null;
---

<section class:list={['image-text', { reverse }]}>
	<div class='copy-wrapper'>
		<div class='copy'>
			{heading && <h2>{heading}</h2>}
			{blocksToParagraphs(text).map((para) => <p>{para}</p>)}
		</div>
	</div>

	{src && <img src={src} alt='' />}
</section>
<style>
	.image-text {
		padding-block: 1rem;
		display: grid;
		gap: 3rem;
	}
	.copy-wrapper {
		padding: 0rem 1rem;
	}
	.copy {
		max-width: 550px;
	}

	img {
		width: 100%;
		height: auto;
		max-height: 600px;
		object-fit: cover;
	}

	@media (min-width: 768px) {
		.copy-wrapper {
			padding: 2rem;
			display: flex;
			align-items: center;
		}
		:not(.reverse) .copy-wrapper {
			justify-content: flex-end;
			text-align: right;
		}
		.reverse .copy-wrapper {
			padding-right: 3rem;
		}
		.image-text {
			grid-template-columns: 1fr 1fr;
		}
		.image-text.reverse .copy-wrapper {
			order: 2;
		}
		.image-text.reverse img {
			order: 1;
		}
	}
</style>
