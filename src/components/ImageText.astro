---
import { imageSrcSet, imageUrl } from '../lib/image';
import { blocksToParagraphs } from '../lib/portableText';
import type { PortableText, SanityImage } from '../lib/types';

interface Props {
	heading?: string;
	text?: PortableText | string;
	image?: SanityImage;
	reverse?: boolean;
}
const { heading, text, image, reverse = false } = Astro.props;
const src = imageUrl(image, { width: 1200 });
const srcset = imageSrcSet(image, [400, 800, 1200]);

// Rough approximation of the two-column desktop layout below, capped so it
// doesn't keep growing past the container's max-width — not exact, but that
// keeps it from silently drifting out of sync with layout tweaks later.
const sizes = '(min-width: 768px) min(50vw, 600px), 100vw';
---

<section class:list={['image-text', { reverse }]}>
	<div class='copy-wrapper'>
		<div class='copy'>
			{heading && <h2>{heading}</h2>}
			{blocksToParagraphs(text).map((para) => <p>{para}</p>)}
		</div>
	</div>

	{
		src && (
			<img
				src={src}
				srcset={srcset ?? undefined}
				sizes={sizes}
				alt={heading ?? ''}
				loading='lazy'
			/>
		)
	}
</section>
<style>
	.image-text {
		padding-block: 1rem;
		display: grid;
		gap: 3rem;
	}
	.copy-wrapper {
		padding: 0rem 1rem;
	}
	.copy {
		max-width: 550px;
	}

	img {
		width: 100%;
		height: auto;
		max-height: 600px;
		object-fit: cover;
	}

	@media (min-width: 768px) {
		.copy-wrapper {
			padding: 2rem;
			display: flex;
			align-items: center;
		}
		:not(.reverse) .copy-wrapper {
			justify-content: flex-end;
			text-align: right;
		}
		.reverse .copy-wrapper {
			padding-right: 3rem;
		}
		.image-text {
			grid-template-columns: 1fr 1fr;
		}
		.image-text.reverse .copy-wrapper {
			order: 2;
		}
		.image-text.reverse img {
			order: 1;
		}
	}
</style>
