---
import { Icon } from 'astro-icon/components';
import { iconoirIconName } from '../lib/icon';
import type { Slug } from '../lib/types';

interface Props {
	title: string;
	summary?: string;
	icon?: string; // Iconoir icon name, e.g. "code-bracket" — see icon-sets.iconify.design/iconoir
	slug?: Slug;
	price?: string;
}
const { title, summary, icon, slug, price } = Astro.props;
const href = slug?.current ? `/services/${slug.current}` : undefined;
const iconName = iconoirIconName(icon);
---

<article class='service-card'>
	{iconName && <Icon class='icon' name={iconName} />}
	<h3>{href ? <a href={href}>{title}</a> : title}</h3>
	{summary && <p>{summary}</p>}
	{price && <p class='price'>{price}</p>}
</article>

<style>
	h3 {
		color: inherit !important;
	}
	h3 a {
		font-size: 1.3rem;
		text-decoration: none;
	}

	.icon {
		width: 2.5rem;
		height: 2.5rem;
		color: inherit;
	}
</style>
