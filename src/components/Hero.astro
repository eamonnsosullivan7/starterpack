---
import { imageDimensions, imageUrl } from '../lib/image';
import type { SanityImage } from '../lib/types';

interface Props {
	heading: string;
	subheading?: string;
	image?: SanityImage;
}
const { heading, subheading, image } = Astro.props;
const src = imageUrl(image, { width: 1600 });
const dimensions = imageDimensions(image, 1600);
---

<section class='hero'>
	<div class='hero-wrapper'>
		<div class='copy-wrapper'>
			<div class='copy'>
				<h1>{heading}</h1>
				{subheading && <p>{subheading}</p>}
			</div>
		</div>
		{
			src && dimensions && (
				<img
					src={src}
					width={dimensions.width}
					height={dimensions.height}
					alt={heading}
					fetchpriority='high'
				/>
			)
		}
	</div>
</section>

<style>
	.hero {
		padding-block: var(--section-block);
	}

	.hero-wrapper {
		display: grid;
		gap: 3rem;
		align-items: center;
		justify-content: flex-end;
	}

	h1 {
		color: var(--color-text-primary);
	}
	img {
		width: 100%;
		height: auto;
		max-height: 100vh;
	}
	.copy-wrapper {
		padding-left: 1rem;
		padding-right: 1rem;
	}
	.copy {
		text-align: left;
		max-width: 500px;
	}

	@media (min-width: 768px) {
		.hero-wrapper {
			grid-template-columns: 1fr 1fr;
			justify-content: flex-end;
		}
		.copy-wrapper {
			display: flex;
			justify-content: flex-end;
		}

		.copy {
			text-align: right;
			display: flex;
			flex-direction: column;
			align-items: flex-end;
		}
		h1 {
			color: var(--color-text-primary);
			text-align: right;
			justify-self: flex-end;
		}
	}
</style>
