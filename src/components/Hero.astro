---
import { urlFor } from '../lib/sanity';

interface Props {
	heading: string;
	subheading?: string;
	image?: any;
}
const { heading, subheading, image } = Astro.props;
const src = image ? urlFor(image).width(1600).auto('format').url() : null;
---

<section class='hero'>
	<div class='hero-wrapper'>
		<div class='copy-wrapper'>
			<div class='copy'>
				<h1>{heading}</h1>
				{subheading && <p>{subheading}</p>}
			</div>
		</div>
		{src && <img src={src} alt='' />}
	</div>
</section>

<style>
	.hero {
		padding-block: 4rem;
	}

	.hero-wrapper {
		display: grid;
		gap: 3rem;
		align-items: center;
		justify-content: flex-end;
	}

	h1 {
		color: var(--color-text-primary);
	}
	img {
		width: 100%;
		height: auto;
		max-height: 100vh;
	}
	.copy-wrapper {
		padding-left: 1rem;
		padding-right: 1rem;
	}
	.copy {
		text-align: left;
		max-width: 500px;
	}

	@media (min-width: 768px) {
		.hero-wrapper {
			grid-template-columns: 1fr 1fr;
			justify-content: flex-end;
		}
		.copy-wrapper {
			display: flex;
			justify-content: flex-end;
		}

		.copy {
			text-align: right;
			display: flex;
			flex-direction: column;
			align-items: flex-end;
		}
		h1 {
			color: var(--color-text-primary);
			text-align: right;
			justify-self: flex-end;
		}
	}
</style>
