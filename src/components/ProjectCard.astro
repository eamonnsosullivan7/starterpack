---
import { imageUrl } from '../lib/image';
import type { SanityImage, Slug } from '../lib/types';

interface Props {
	title: string;
	shortDescription?: string;
	coverImage?: SanityImage;
	slug?: Slug;
	showButton?: boolean;
}
const {
	title,
	shortDescription,
	coverImage,
	slug,
	showButton = false,
} = Astro.props;
const href = slug?.current ? `/projects/${slug.current}` : undefined;
const src = imageUrl(coverImage, { width: 800, height: 600 });
---

<article class='project-card'>
	{
		href ? (
			<a href={href}>{src && <img src={src} alt={title} loading='lazy' />}</a>
		) : (
			src && <img src={src} alt={title} loading='lazy' />
		)
	}
	<h3>{href ? <a href={href}>{title}</a> : title}</h3>
	{shortDescription && <p>{shortDescription}</p>}
	{
		showButton && href && (
			<a class='view-project' href={href}>
				View project →
			</a>
		)
	}
</article>

<style>
	.project-card img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}
	h3 {
		margin-bottom: 4px;
		margin-top: 0.5rem;
	}
	h3 a {
		text-decoration: none;
	}

	.view-project {
		display: inline-block;
		margin-top: 0.5rem;
		font-weight: 600;
	}
</style>
