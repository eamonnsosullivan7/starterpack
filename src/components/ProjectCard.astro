---
import { imageSrcSet, imageUrl } from '../lib/image';
import type { SanityImage, Slug } from '../lib/types';

interface Props {
	title: string;
	shortDescription?: string;
	coverImage?: SanityImage;
	slug?: Slug;
	showButton?: boolean;
}
const {
	title,
	shortDescription,
	coverImage,
	slug,
	showButton = false,
} = Astro.props;
const href = slug?.current ? `/projects/${slug.current}` : undefined;
const src = imageUrl(coverImage, { width: 800, height: 600 });
const srcset = imageSrcSet(coverImage, [400, 800], 800 / 600);

// Rough approximation of the 1/2/3-column grids this card is used in — not
// exact, but that keeps it from silently drifting out of sync with layout
// tweaks later (this card is used in more than one grid with slightly
// different breakpoints).
const sizes = '(min-width: 1024px) min(33vw, 380px), (min-width: 640px) min(50vw, 500px), 100vw';
---

<article class='project-card'>
	{
		href ? (
			<a href={href}>
				{src && (
					<img
						src={src}
						srcset={srcset ?? undefined}
						sizes={sizes}
						alt={title}
						loading='lazy'
					/>
				)}
			</a>
		) : (
			src && (
				<img
					src={src}
					srcset={srcset ?? undefined}
					sizes={sizes}
					alt={title}
					loading='lazy'
				/>
			)
		)
	}
	<h3>{href ? <a href={href}>{title}</a> : title}</h3>
	{shortDescription && <p>{shortDescription}</p>}
	{
		showButton && href && (
			<a class='view-project' href={href}>
				View project →
			</a>
		)
	}
</article>

<style>
	.project-card img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}
	h3 {
		margin-bottom: 4px;
		margin-top: 0.5rem;
	}
	h3 a {
		text-decoration: none;
	}

	.view-project {
		display: inline-block;
		margin-top: 0.5rem;
		font-weight: 600;
	}
</style>
