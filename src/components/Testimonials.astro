---
import { Icon } from 'astro-icon/components';
import TestimonialCard from './TestimonialCard.astro';
import type { Testimonial } from '../lib/types';

interface Props {
	heading?: string;
	subheading?: string;
	items: Testimonial[];
}
const { heading, subheading, items } = Astro.props;
---

<section class='testimonials'>
	<div class='testimonials-wrapper'>
		<div class='testimonials-heading'>
			{
				heading && (
					<>
						<h2>{heading}</h2>
						{subheading && <p>{subheading}</p>}
					</>
				)
			}
			{
				items.length > 1 && (
					<div class='nav'>
						<button
							type='button'
							class='nav-btn prev'
							aria-label='Previous testimonial'
						>
							<Icon class='icon' name='iconoir:nav-arrow-left' />
						</button>
						<button
							type='button'
							class='nav-btn next'
							aria-label='Next testimonial'
						>
							<Icon class='icon' name='iconoir:nav-arrow-right' />
						</button>
					</div>
				)
			}
		</div>
		<div class='testimonials-slides'>
			{
				items.map((item, index) => (
					<div
						class='slide'
						class:list={{ 'is-active': index === 0 }}
						inert={index !== 0}
					>
						<TestimonialCard {...item} />
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.testimonials').forEach((section) => {
		const slides = Array.from(section.querySelectorAll<HTMLElement>('.slide'));
		if (slides.length < 2) return;

		let current = Math.max(
			slides.findIndex((slide) => slide.classList.contains('is-active')),
			0,
		);

		const show = (index: number) => {
			slides[current].classList.remove('is-active');
			slides[current].inert = true;
			current = (index + slides.length) % slides.length;
			slides[current].classList.add('is-active');
			slides[current].inert = false;
		};

		section
			.querySelector('.prev')
			?.addEventListener('click', () => show(current - 1));
		section
			.querySelector('.next')
			?.addEventListener('click', () => show(current + 1));
	});
</script>

<style>
	.testimonials {
		padding-block: var(--section-block);
	}

	.testimonials-wrapper {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.testimonials-heading {
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.testimonials-heading h2 {
		font-size: 2.5rem;
		margin-block: 1rem 0.5rem;
	}

	.nav {
		display: flex;
		gap: 0.75rem;
		margin-top: auto;
		padding-bottom: 2rem;
	}
	.nav-btn {
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		border: 1px solid var(--color-text-tertiary);
		background: none;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: var(--color-text-primary);
		padding: 0;
	}
	.nav-btn:hover {
		background-color: var(--color-secondary);
		color: var(--color-primary);
		border-color: var(--color-secondary);
	}
	.icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.testimonials-slides {
		display: grid;
		flex: 1.5;
	}
	.slide {
		grid-area: 1 / 1;
		opacity: 0;
		transition: opacity 300ms ease;
		pointer-events: none;
	}
	.slide.is-active {
		opacity: 1;
		pointer-events: auto;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.slide {
			transition: none;
		}
	}

	@media (min-width: 992px) {
		.testimonials-wrapper {
			flex-direction: row;
			justify-content: space-between;
			gap: 2em;
		}
	}
</style>
