---
import ServiceCard from './ServiceCard.astro';
import type { Service } from '../lib/types';

interface Props {
	heading?: string;
	items: Service[];
	viewAllHref?: string;
}
const { heading = 'Services', items, viewAllHref = '/services' } = Astro.props;
---

<section class='services'>
	<div class='container'>
		<h2>{heading}</h2>
		<div class='grid'>
			{items.map((service) => <ServiceCard {...service} />)}
		</div>
		<div class='view-all-wrapper'>
			<a class='view-all' href={viewAllHref}> View all services → </a>
		</div>
	</div>
</section>

<style>
	.services {
		padding-block: var(--section-block);
		background-color: var(--color-secondary);
		color: var(--color-primary);
	}
	.services h2 {
		color: var(--color-primary);
	}
	.grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
	}
	h2 {
		font-size: 2rem;
		margin: 3rem 0 1.5rem 0;
	}
	.view-all-wrapper {
		display: flex;
		justify-content: flex-end;
	}
	.view-all {
		display: inline-block;
		margin-top: 1.5rem;
		font-weight: 600;
		color: var(--color-text-seconday);
	}

	@media (min-width: 992px) {
		.grid {
			gap: 2rem;
		}
	}
</style>
