---
import { Icon } from 'astro-icon/components';
import { imageUrl } from '../lib/image';
import type { SanityImage } from '../lib/types';

interface Props {
	quote: string;
	authorName: string;
	authorRole?: string;
	authorPhoto?: SanityImage;
}
const { quote, authorName, authorRole, authorPhoto } = Astro.props;
const src = imageUrl(authorPhoto, { width: 120, height: 120 });
---

<figure class='testimonial'>
	<blockquote>
		<Icon class='quote-icon' name='iconoir:quote-solid' />
		{quote}&rdquo;
	</blockquote>
	<figcaption>
		{src && <img src={src} alt={authorName} loading='lazy' />}
		<span>
			<strong>{authorName}</strong>
			{authorRole && <span class='role'>{authorRole}</span>}
		</span>
	</figcaption>
</figure>

<style>
	.testimonial {
		position: relative;
		margin: 0;
		padding: 1.5rem;
		border-radius: 0.5rem;
		display: flex;
		justify-content: space-between;
		flex-direction: column;
	}
	.quote-icon {
		height: 2rem;
		width: 2rem;
		transform: scale(-1);
		display: block;
	}
	blockquote {
		margin: 0rem;
	}
	figcaption {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1rem;
	}
	img {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: cover;
	}
	.role {
		display: block;
		color: var(--color-text-tertiary);
		font-size: 0.875rem;
	}
</style>
